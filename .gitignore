# --- Fichiers spécifiques au projet / outils locaux ---
CLAUDE.MD
.claude

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Environnements virtuels
# NB : on n'ignore PAS `env/` car c'est le package de l'environnement Gymnasium
# du projet (env/game2048_env.py). On cible donc des noms de venv explicites.
.venv/
venv/
.env/

# Packaging / distribution
build/
dist/
*.egg-info/
.eggs/

# --- Tests & couverture ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- Parties enregistrées (relecture) ---
# Générées à l'exécution (scripts/watch_games.py --record) ; on ne les versionne
# pas par défaut. Pour conserver une partie précise, ajoute-la avec `git add -f`.
recordings/

# --- Reinforcement Learning (artefacts d'entraînement) ---
# Modèles entraînés, logs et checkpoints : volumineux, on ne versionne pas.
models/
*.zip
*.pt
*.pth
logs/
tensorboard/
runs/

# --- Éditeurs / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
